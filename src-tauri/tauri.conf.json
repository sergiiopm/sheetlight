{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheetlight",
  "version": "1.0.0",
  "identifier": "com.sheetlight.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sheetlight",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "fileAssociations": [
      {
        "ext": ["xlsx"],
        "name": "Sheetlight.Xlsx",
        "description": "Excel Workbook",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "role": "Editor"
      },
      {
        "ext": ["xls"],
        "name": "Sheetlight.Xls",
        "description": "Excel 97-2003 Workbook",
        "mimeType": "application/vnd.ms-excel",
        "role": "Editor"
      },
      {
        "ext": ["csv"],
        "name": "Sheetlight.Csv",
        "description": "CSV File",
        "mimeType": "text/csv",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
